{
  "name": "mg-ats-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "MG-ATS desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "node scripts/stage-backend.cjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mgats.desktop",
    "productName": "MG-ATS",
    "copyright": "MG-ATS",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": ".pack/backend/dist",
        "to": "backend/dist",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts"
        ]
      },
      {
        "from": ".pack/backend/prisma",
        "to": "backend/prisma",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-journal"
        ]
      },
      {
        "from": ".pack/backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*",
          "!**/{README,readme,CHANGELOG,changelog}*",
          "!**/*.md",
          "!**/*.map",
          "!**/{test,tests,__tests__,docs,doc,example,examples,coverage}/**",
          "!**/.bin/**",
          "!**/better-sqlite3/{deps,src,build/Release/obj}/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "ui"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MG-ATS",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "MG-ATS"
    }
  }
}
