generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ApplicationStatus {
  UPLOADED
  PARSING
  PARSED
  PARSE_FAILED
  EXTRACTING
  EXTRACTED
  EXTRACT_FAILED
  SCORING
  SCORED
  SCORE_FAILED
  PENDING_REVIEW
}

enum BatchStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum Bucket {
  STRONG_FIT
  NEEDS_REVIEW
  HARD_FILTERED
}

enum AuthenticitySignal {
  NATURAL
  TEMPLATED
  UNCERTAIN
}

enum HumanDecision {
  SHORTLIST
  REJECT
  MAYBE
}

enum QuestionCategory {
  VERIFY_CLAIM
  PROBE_GAP
  EXPLORE_STRENGTH
  AUTHENTICITY_CHECK
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum SeniorityLevel {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
}

model Job {
  id               String           @id @default(uuid())
  title            String
  description      String           @default("")
  location         String?
  workplace        WorkplaceType?
  employmentType   EmploymentType?  @map("employment_type")
  seniority        SeniorityLevel?
  mustHaves        Json             @default("[]") @map("must_haves")
  niceToHaves      Json             @default("[]") @map("nice_to_haves")
  skills           Json             @default("[]")
  minYears         Int?             @map("min_years")
  education        String?
  salaryMin        Float?           @map("salary_min")
  salaryMax        Float?           @map("salary_max")
  salaryCurrency   String?          @map("salary_currency")
  closesAt         DateTime?        @map("closes_at")
  postedAt         DateTime         @default(now()) @map("posted_at")
  requirementsJson Json             @map("requirements_json")
  status           String           @default("open")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  applications Application[]
  batches      Batch[]

  @@index([postedAt])
  @@map("jobs")
}

model Candidate {
  id        String   @id @default(uuid())
  name      String?
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  applications Application[]

  @@map("candidates")
}

model Batch {
  id             String      @id @default(uuid())
  jobId          String      @map("job_id")
  totalFiles     Int         @default(0) @map("total_files")
  processedCount Int         @default(0) @map("processed_count")
  failedCount    Int         @default(0) @map("failed_count")
  status         BatchStatus @default(PROCESSING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  job          Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("batches")
}

model Application {
  id             String            @id @default(uuid())
  candidateId    String            @map("candidate_id")
  jobId          String            @map("job_id")
  batchId        String?           @map("batch_id")
  status         ApplicationStatus @default(UPLOADED)
  rawFilePath    String?           @map("raw_file_path")
  rawResumeText  String?           @map("raw_resume_text")
  parsedJson     Json?             @map("parsed_json")
  failureReason  String?           @map("failure_reason")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  candidate          Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  batch              Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  score              Score?
  reviews            Review[]
  interviewQuestions InterviewQuestion[]
  modelOpinions      ModelOpinion[]

  @@index([jobId, status])
  @@index([batchId])
  @@map("applications")
}

model Score {
  id                    String             @id @default(uuid())
  applicationId         String             @unique @map("application_id")
  fitScore              Float              @map("fit_score")
  fitRationaleJson      Json               @map("fit_rationale_json")
  authenticitySignal    AuthenticitySignal @map("authenticity_signal")
  authenticityReasoning String             @map("authenticity_reasoning")
  bucket                Bucket
  disagreement          Boolean            @default(false)
  createdAt             DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("scores")
}

model ModelOpinion {
  id                      String              @id @default(uuid())
  applicationId           String              @map("application_id")
  provider                String
  model                   String
  fitScore                Float?              @map("fit_score")
  fitRationaleJson        Json?               @map("fit_rationale_json")
  authenticitySignal      AuthenticitySignal? @map("authenticity_signal")
  authenticityReasoning   String?             @map("authenticity_reasoning")
  requirementChecksJson   Json?               @map("requirement_checks_json")
  error                   String?
  createdAt               DateTime            @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, provider])
  @@map("model_opinions")
}

model Review {
  id             String        @id @default(uuid())
  applicationId  String        @map("application_id")
  humanDecision  HumanDecision @map("human_decision")
  overrodeBucket Boolean       @default(false) @map("overrode_bucket")
  note           String?
  createdAt      DateTime      @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model InterviewQuestion {
  id            String           @id @default(uuid())
  applicationId String           @map("application_id")
  questionText  String           @map("question_text")
  category      QuestionCategory
  groundedIn    String           @map("grounded_in")
  createdAt     DateTime         @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interview_questions")
}
